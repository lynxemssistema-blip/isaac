<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Encaminhar chamadas /api para o Backend Node.js caso mod_proxy esteja ativo
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]
  </IfModule>

  # 2. Não reescrever rotas de API para o index.html
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 3. Se o arquivo ou diretório solicitado existir fisicamente (js, css, imagens), entregá-lo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Redirecionar todas as rotas SPA (/login, /admin, /inscricao, etc.) para o index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Habilitar compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Cache de arquivos estáticos no navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
